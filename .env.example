# Copy to .env.local and fill in. Analytics stays off while the token is empty.
# PostHog project token (Project Settings > General). Public by design: it can only send events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# https://eu.i.posthog.com for an EU project, https://us.i.posthog.com for a US one.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
